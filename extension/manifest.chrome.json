{
	"manifest_version": 3,
	"name": "Browser Lambdas",
	"description": "Lambda functions and terminal for your browser.",
	"permissions": [
		"storage",
		"tabs",
		"scripting",
		"declarativeNetRequestWithHostAccess",
		"webNavigation",
		"userScripts"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"web_accessible_resources": [{
		"resources": ["shell.html", "popup-menu.html"],
		"matches": ["<all_urls>"]
	}],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/popup-icon16.png",
			"32": "icons/popup-icon32.png",
			"48": "icons/popup-icon48.png",
			"128": "icons/popup-icon128.png"
		}
	},
	"icons": {
		"16": "icons/extension-page-icon16.png",
		"32": "icons/extension-page-icon32.png",
		"48": "icons/extension-page-icon48.png",
		"128": "icons/extension-page-icon128.png"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"shared/storage.js",
				"shared/activityLog.js",
				"shared/secureChannel.js",
				"content/parseInput.js",
				"content/popupMenu.js",
				"content/messages.js",
				"content/shell.js",
				"content/keybinding.js",
				"content/index.js"
			]
		}
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	}
}
